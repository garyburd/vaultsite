A publish marks deleted the note of a collection the service no longer
has, as when the user deleted it and chose to leave its photos, which
Lightroom doesn't report.
-- request.json --
{
	"protocol": 5,
	"op": "publish",
	"service": [
		{
			"id": 10,
			"path": [
				"Recent"
			]
		}
	],
	"collection": 10,
	"photos": [
		{
			"uuid": "A1000000-0000-0000-0000-000000000001",
			"rendition": "$RENDER/1.jpg"
		}
	]
}
-- render/1.jpg --
full 1 new
-- vault/Galleries/Old.md --
---
cssclasses:
  - image-grid
lightroom-collection: 99
lightroom-path: Old
---
-- vault/Galleries/Recent.md --
---
cssclasses:
  - image-grid
lightroom-collection: 10
lightroom-path: Recent
---
-- want/response.json --
{
	"protocol": 5,
	"photos": [
		{
			"uuid": "A1000000-0000-0000-0000-000000000001",
			"remoteId": "a1000000000000000000000000000001.jpg"
		}
	]
}
-- want/log --
Recent: stored 1 of 1 photos
Galleries/Recent.md: added 1 figure
marked Galleries/Old.md deleted
-- want/vault/.vaultsite/fullsize/cat/a1/a1000000000000000000000000000001.jpg --
full 1 new
-- want/vault/Galleries/Attachments/thumbs/a1/a1000000000000000000000000000001.jpg --
thumb of full 1 new
-- want/vault/Galleries/Old.md --
---
cssclasses:
  - image-grid
lightroom-deleted: Old
vaultsite-draft: true
---
-- want/vault/Galleries/Recent.md --
---
cssclasses:
  - image-grid
lightroom-collection: 10
lightroom-path: Recent
---

[![](Galleries/Attachments/thumbs/a1/a1000000000000000000000000000001.jpg)](vaultsite-fullsize:cat/a1/a1000000000000000000000000000001)
