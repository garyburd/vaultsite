Republishing a photo whose thumbnail would be the same leaves the
thumbnail file alone, so that iCloud and Obsidian see no change. Its
full-size image is written again.
-- request.json --
{
	"protocol": 5,
	"op": "publish",
	"service": [
		{
			"id": 10,
			"path": [
				"Recent"
			]
		}
	],
	"collection": 10,
	"photos": [
		{
			"uuid": "A1000000-0000-0000-0000-000000000001",
			"rendition": "$RENDER/1.jpg"
		}
	]
}
-- render/1.jpg --
full 1 new
-- vault/Galleries/Recent.md --
---
lightroom-collection: 10
lightroom-path: Recent
---

[![](Galleries/Attachments/thumbs/a1/a1000000000000000000000000000001.jpg)](vaultsite-fullsize:cat/a1/a1000000000000000000000000000001)
-- vault/.vaultsite/fullsize/cat/a1/a1000000000000000000000000000001.jpg --
full 1
-- vault/Galleries/Attachments/thumbs/a1/a1000000000000000000000000000001.jpg --
thumb of full 1 new
-- want/response.json --
{
	"protocol": 5,
	"photos": [
		{
			"uuid": "A1000000-0000-0000-0000-000000000001",
			"remoteId": "a1000000000000000000000000000001.jpg"
		}
	]
}
-- want/log --
thumbnail a1000000000000000000000000000001: unchanged
Recent: stored 1 of 1 photos
-- want/vault/.vaultsite/fullsize/cat/a1/a1000000000000000000000000000001.jpg --
full 1 new
-- want/vault/Galleries/Attachments/thumbs/a1/a1000000000000000000000000000001.jpg --
thumb of full 1 new
-- want/vault/Galleries/Recent.md --
---
lightroom-collection: 10
lightroom-path: Recent
---

[![](Galleries/Attachments/thumbs/a1/a1000000000000000000000000000001.jpg)](vaultsite-fullsize:cat/a1/a1000000000000000000000000000001)
