full 1
-- want/vault/.vaultsite/fullsize/cat/b2/b2000000000000000000000000000002.jpg --
full 2
-- want/vault/.vaultsite/fullsize/cat/d4/d4000000000000000000000000000004.jpg --
full 4 new
-- want/vault/Galleries/Attachments/thumbs/a1/a1000000000000000000000000000001.jpg --
thumb 1
-- want/vault/Galleries/Attachments/thumbs/b2/b2000000000000000000000000000002.jpg --
thumb 2
-- want/vault/Galleries/Attachments/thumbs/c3/c3000000000000000000000000000003.jpg --
thumb 3
-- want/vault/Galleries/Attachments/thumbs/d4/d4000000000000000000000000000004.jpg --
thumb of full 4 new
