Photos that can't be stored fail one at a time: a bad UUID, a rendition
without an extension, a rendition that's gone, and a figure whose
thumbnail's folder is gone. Photo 5 is stored.
-- request.json --
{
	"protocol": 5,
	"op": "publish",
	"service": [
		{
			"id": 10,
			"path": [
				"Recent"
			]
		}
	],
	"collection": 10,
	"photos": [
		{
			"uuid": "nonsense",
			"rendition": "$RENDER/1.jpg"
		},
		{
			"uuid": "B2000000-0000-0000-0000-000000000002",
			"rendition": "$RENDER/2"
		},
		{
			"uuid": "C3000000-0000-0000-0000-000000000003",
			"rendition": "$RENDER/3.jpg"
		},
		{
			"uuid": "D4000000-0000-0000-0000-000000000004",
			"rendition": "$RENDER/4.jpg"
		},
		{
			"uuid": "E5000000-0000-0000-0000-000000000005",
			"rendition": "$RENDER/5.jpg"
		}
	]
}
-- render/1.jpg --
full 1 new
-- render/2 --
full 2
-- render/4.jpg --
full 4 new
-- render/5.jpg --
full 5 new
